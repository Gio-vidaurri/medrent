---
/**
 * Modal “Saber más” en /eventos.
 * Misma base que `popUpSolicitarCotizacion`: backdrop `bg-black/50 backdrop-blur-sm` (difumina el viewport),
 * scroll + centrado en el wrapper, `id="PopupContent"` en la tarjeta con `pointer-events-auto`.
 * Renderizado vía Layout slot="overlays" (fuera de <main>) para `position:fixed` correcto.
 */
import BaseForm from "@components/forms/BaseForm.astro";
import FormField from "@components/forms/FormField.astro";
import CheckboxField from "@components/forms/CheckboxField.astro";
import SubmitButton from "@components/forms/SubmitButton.astro";
---

<div id="event-popup-overlay" class="fixed inset-0 z-[110] hidden" aria-hidden="true">
    <div
        id="event-blurred-background"
        class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-all duration-300"
        aria-hidden="true"
    >
    </div>

    <div
        class="relative z-10 flex min-h-screen w-full items-center justify-center overflow-y-auto overflow-x-hidden p-4 md:py-6"
    >
        <div
            id="PopupContent"
            class="pointer-events-auto relative grid w-full max-w-[min(100vw-2rem,1024px)] grid-cols-1 overflow-hidden rounded-2xl border border-[#6D7A78] bg-white shadow-xl lg:grid-cols-2"
        >
            <button
                id="close-event-popup"
                type="button"
                class="absolute top-2 right-2 z-50 hidden min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center rounded-md border-none bg-[var(--Schemes-On-Primary-Fixed,#00201F)] text-2xl leading-none text-white hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#00201F] sm:top-3 sm:right-3 lg:flex"
                aria-label="Cerrar"
            >
                ×
            </button>

            <div
                id="event-popup-left"
                class="relative hidden h-full min-h-0 w-full min-w-0 self-stretch overflow-hidden bg-[#F5FAF9] lg:block lg:min-h-[500px]"
            >
                <img
                    id="event-popup-image"
                    src=""
                    alt="Evento"
                    class="absolute inset-0 h-full w-full object-cover object-center"
                    loading="lazy"
                    decoding="async"
                />
            </div>

            <div
                id="event-popup-right"
                class="relative flex min-h-0 w-full min-w-0 flex-col gap-5 overflow-x-hidden overflow-y-auto bg-[#F5FAF9] p-4 pt-14 sm:gap-6 sm:p-6 lg:min-h-[500px] lg:pt-12 lg:p-8"
            >
                <button
                    id="close-event-popup-mobile"
                    type="button"
                    class="absolute top-2 right-2 z-20 flex min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center rounded-md border-none bg-[var(--Schemes-On-Primary-Fixed,#00201F)] text-2xl leading-none text-white hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#00201F] lg:hidden"
                    aria-label="Cerrar"
                >
                    ×
                </button>
                <div class="flex w-full min-w-0 shrink-0 flex-col gap-4" id="event-popup-text">
                    <p
                        id="event-popup-event-type"
                        class="hidden font-lato text-xs font-medium uppercase tracking-wide text-[var(--color-accent)] sm:text-[13px] lg:text-[14px]"
                    >
                    </p>
                    <h2
                        id="event-popup-title"
                        class="w-full min-w-0 font-lato text-lg font-bold leading-snug text-[#261819] sm:text-xl lg:text-[22px]"
                    >
                        Título del evento
                    </h2>
                    <p
                        id="event-popup-description"
                        class="w-full min-w-0 text-pretty font-lato text-[15px] leading-relaxed text-[#5A4043] sm:text-base"
                    >
                        Descripción del evento
                    </p>
                </div>

                <ul class="m-0 flex w-full min-w-0 shrink-0 list-none flex-col gap-3 p-0 sm:gap-4" id="event-popup-meta">
                        <li id="event-popup-meta-location" class="hidden flex items-start gap-2.5 sm:gap-3">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                class="mt-0.5 size-5 shrink-0 sm:size-6"
                                aria-hidden="true"
                            >
                                <path
                                    d="M12 21C11.656 21 11.336 20.823 11.153 20.532L7.19501 14.227C6.98901 13.9 6.79201 13.565 6.61601 13.222C5.34901 10.739 4.01501 7.08802 7.04801 4.05302C8.35801 2.74202 10.116 2.02002 12 2.02002C13.883 2.02002 15.642 2.74202 16.952 4.05202C20.002 7.10402 18.638 10.788 17.347 13.293C17.195 13.589 17.024 13.879 16.847 14.162L12.847 20.532C12.664 20.823 12.344 21 12 21ZM12 4.02002C10.65 4.02002 9.39401 4.53302 8.46201 5.46602C6.81101 7.11902 6.79101 9.16702 8.39701 12.312C8.54501 12.603 8.71401 12.886 8.88801 13.163L12 18.12L15.152 13.099C15.298 12.865 15.442 12.624 15.568 12.377C17.209 9.19502 17.199 7.12802 15.538 5.46602C14.605 4.53302 13.35 4.02002 12 4.02002Z"
                                    fill="#3D4948"
                                ></path>
                                <path
                                    d="M12 12C10.346 12 9 10.654 9 9C9 7.346 10.346 6 12 6C13.654 6 15 7.346 15 9C15 10.654 13.654 12 12 12ZM12 8C11.449 8 11 8.449 11 9C11 9.551 11.449 10 12 10C12.551 10 13 9.551 13 9C13 8.449 12.551 8 12 8Z"
                                    fill="#3D4948"
                                ></path>
                                <path d="M17 19H7V21H17V19Z" fill="#3D4948"></path>
                            </svg>
                            <a
                                id="event-popup-location-link"
                                href="#"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="break-words font-lato text-sm text-[#261819] transition-colors hover:text-[var(--color-accent)] sm:text-[15px] lg:text-base"
                            >
                                <span id="event-popup-location-label"></span>
                            </a>
                        </li>
                        <li id="event-popup-meta-date" class="hidden flex items-start gap-2.5 sm:gap-3">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                class="mt-0.5 size-5 shrink-0 sm:size-6"
                                aria-hidden="true"
                            >
                                <path
                                    d="M17 4V2H15V4H9V2H7V4H3V21H21V4H17ZM7 6V8H9V6H15V8H17V6H19V10H5V6H7ZM5 19V12H19V19H5Z"
                                    fill="#3D4948"
                                ></path>
                            </svg>
                            <span id="event-popup-date" class="font-lato text-sm text-[#261819] sm:text-[15px] lg:text-base"
                            ></span>
                        </li>
                        <li id="event-popup-time-row" class="hidden flex items-start gap-2.5 sm:gap-3">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                class="mt-0.5 size-5 shrink-0 sm:size-6"
                                aria-hidden="true"
                            >
                                <path
                                    d="M12 2C10.0222 2 8.08879 2.58649 6.4443 3.6853C4.79981 4.78412 3.51809 6.3459 2.76121 8.17317C2.00433 10.0004 1.8063 12.0111 2.19215 13.9509C2.578 15.8907 3.53041 17.6725 4.92894 19.0711C6.32746 20.4696 8.10929 21.422 10.0491 21.8079C11.9889 22.1937 13.9996 21.9957 15.8268 21.2388C17.6541 20.4819 19.2159 19.2002 20.3147 17.5557C21.4135 15.9112 22 13.9778 22 12C21.9971 9.34874 20.9425 6.80691 19.0678 4.93219C17.1931 3.05746 14.6513 2.00295 12 2ZM12 20C10.4178 20 8.87104 19.5308 7.55544 18.6518C6.23985 17.7727 5.21447 16.5233 4.60897 15.0615C4.00347 13.5997 3.84504 11.9911 4.15372 10.4393C4.4624 8.88743 5.22433 7.46197 6.34315 6.34315C7.46197 5.22433 8.88743 4.4624 10.4393 4.15372C11.9911 3.84504 13.5997 4.00346 15.0615 4.60896C16.5233 5.21447 17.7727 6.23984 18.6518 7.55544C19.5308 8.87103 20 10.4177 20 12C19.9976 14.121 19.1539 16.1544 17.6542 17.6542C16.1544 19.1539 14.121 19.9976 12 20ZM14.0981 9.63379L13 10.2681V7C13 6.73478 12.8946 6.48043 12.7071 6.29289C12.5196 6.10536 12.2652 6 12 6C11.7348 6 11.4804 6.10536 11.2929 6.29289C11.1054 6.48043 11 6.73478 11 7V12C11 12.1755 11.0463 12.3479 11.1341 12.4999C11.2218 12.6519 11.3481 12.7782 11.5 12.8659C11.652 12.9537 11.8245 13 12 13C12.1755 13 12.348 12.9539 12.5 12.8662L15.0981 11.3662C15.212 11.3006 15.3117 11.2132 15.3918 11.109C15.4718 11.0048 15.5305 10.8858 15.5646 10.7589C15.5986 10.632 15.6073 10.4997 15.5902 10.3694C15.5731 10.2392 15.5305 10.1135 15.4648 9.99974C15.3991 9.88595 15.3117 9.78622 15.2074 9.70624C15.1032 9.62626 14.9842 9.56761 14.8573 9.53362C14.7304 9.49964 14.598 9.49099 14.4678 9.50818C14.3375 9.52537 14.2119 9.56805 14.0981 9.63379Z"
                                    fill="#3D4948"
                                ></path>
                            </svg>
                            <span id="event-popup-time" class="font-lato text-sm text-[#261819] sm:text-[15px] lg:text-base"
                            ></span>
                        </li>
                </ul>

                <BaseForm
                    id="events-form"
                    wrapperClass="flex w-full min-w-0 shrink-0 flex-col self-stretch"
                    containerClass="w-full min-w-0"
                    class="flex w-full min-w-0 flex-col rounded"
                >
                    <div class="flex w-full min-w-0 flex-col gap-7">
                        <FormField
                            label="Nombre completo"
                            name="name"
                            placeholder="Ej: Dra. Carolina Ávila"
                        />
                        <FormField
                            label="Correo electrónico"
                            name="email"
                            type="email"
                            placeholder="Ej: carolina.avila@hospitalneuro.mx"
                        />
                    </div>
                    <div class="pt-4">
                        <CheckboxField
                            id="aviso"
                            label="He leído y acepto el"
                            link="/aviso-de-privacidad"
                        />
                    </div>
                    <div class="pt-3 sm:pt-4">
                        <SubmitButton text="Regístrate"></SubmitButton>
                    </div>
                </BaseForm>

                <script type="module">
                    import { initForm } from "/scripts/formValidator.js";

                    document.addEventListener("DOMContentLoaded", () => {
                        initForm("events-form");
                    });
                </script>
            </div>

            <div
                id="status"
                class="absolute inset-0 z-40 hidden flex-col items-center justify-center overflow-y-auto bg-white p-4 text-center text-sm"
            >
            </div>
        </div>
    </div>
</div>
