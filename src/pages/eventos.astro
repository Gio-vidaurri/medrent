.9497 54.0732 52.271 54.009 52.5706 53.8842C52.8702 53.7593 53.1421 53.5765 53.3706 53.346C53.8285 52.8854 54.0855 52.2624 54.0855 51.6129C54.0855 50.9635 53.8285 50.3404 53.3706 49.8798ZM12.2917 19.6667C12.2969 19.1657 12.4551 18.6783 12.7451 18.2697C13.0351 17.861 13.443 17.5508 13.9142 17.3805L23.5755 27.0418H12.2917V19.6667ZM14.75 46.7085C14.0981 46.7085 13.4728 46.4495 13.0117 45.9885C12.5507 45.5275 12.2917 44.9022 12.2917 44.2502V31.9585H28.4922L43.2422 46.7085H14.75Z" fill="#006764"/>
                            </svg>
                            <p class="text-[#006764] font-bold text-base md:text-lg lg:text-xl text-center">Este mes no cuenta con eventos programados</p>
                            <p class="text-gray-600 text-xs md:text-sm text-center">Consulta otros meses para conocer nuestras próximas actividades académicas y clínicas.</p>
                        </div>
                    `;
                }
            }
        }
        
        // EVENT LISTENERS
        
        function bindPopupFromTrigger(el) {
            const open = () => {
                openEventPopup({
                    img: el.getAttribute('data-img') || '',
                    title: el.getAttribute('data-title') || 'Evento MedRent',
                    description: el.getAttribute('data-description') || '',
                    eventType: el.getAttribute('data-event-type') || '',
                    dateLabel: el.getAttribute('data-date-label') || '',
                    timeLabel: el.getAttribute('data-time-label') || '',
                    locationLabel: el.getAttribute('data-location-label') || '',
                    locationUrl: el.getAttribute('data-location-url') || '#',
                });
            };
            el.addEventListener('click', (e) => {
                e.preventDefault();
                open();
            });
            el.addEventListener('keydown', (e) => {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                if (el.tagName === 'BUTTON') return;
                e.preventDefault();
                open();
            });
        }

        document.querySelectorAll('.event-popup-trigger').forEach(bindPopupFromTrigger);
        
        // Cerrar popup
        document
            .querySelectorAll('#close-event-popup, #close-event-popup-mobile')
            .forEach((btn) => {
                btn.addEventListener('click', closeEventPopup);
            });
        if (popupOverlay) {
            popupOverlay.addEventListener('click', (e) => {
                const card = document.getElementById('PopupContent');
                if (card && !card.contains(e.target)) closeEventPopup();
            });
        }
        
        // Tecla Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && popupOverlay && !popupOverlay.classList.contains('hidden')) {
                closeEventPopup();
            }
        });
        
        // Envío del formulario
        // if (form) {
        //     form.addEventListener('submit', async (e) => {
        //         e.preventDefault();
        //         form.style.display = 'none';
        //         showFormMessage('success');
                
        //         setTimeout(() => {
        //             if (status) {
        //                 status.innerHTML = '';
        //                 status.style.display = 'none';
        //             }
        //             form.style.display = 'block';
        //             form.reset();
        //         }, 38000);
        //     });
        // }
        
        // CALENDARIO (interactivo: hoy, eventos, selección, sync scroll, prev/next)
        let displayedMonthKey = '';
        /** @type {string | null} */
        let selectedDateIso = null;
        /** @type {number} */
        let scrollSyncRaf = 0;
        /** @type {number} */
        let suppressScrollSyncUntil = 0;

        /** @param {string} mesKey */
        function getDiasConEventosForMonth(mesKey) {
            const seccionMes = document.querySelector(`[data-month="${mesKey}"]`);
            if (!seccionMes) return [];
            const eventDaysAttr = seccionMes.getAttribute('data-event-days');
            if (!eventDaysAttr) return [];
            try {
                const arr = JSON.parse(eventDaysAttr);
                return Array.isArray(arr) ? arr : [];
            } catch {
                return [];
            }
        }

        /** @param {string} fechaBase */
        function generarCalendario(fechaBase) {
            const fecha = dayjs(fechaBase);
            const startOfMonth = fecha.startOf('month');
            const startOfWeek = startOfMonth.startOf('week');

            const dias = [];
            let currentDay = startOfWeek;

            for (let i = 0; i < 42; i++) {
                dias.push({
                    day: currentDay.date(),
                    isCurrentMonth: currentDay.month() === fecha.month(),
                    isToday: currentDay.isSame(dayjs(), 'day'),
                    fullDate: currentDay.format('YYYY-MM-DD'),
                });
                currentDay = currentDay.add(1, 'day');
            }

            const raw = fecha.format('MMMM YYYY');
            const nombreMes =
                raw.charAt(0).toUpperCase() + raw.slice(1).toLowerCase();

            return { dias, nombreMes };
        }

        function updateNavButtons() {
            const el = document.getElementById('calendario-dinamico');
            const min = el?.dataset.minMonth;
            const max = el?.dataset.maxMonth;
            const prev = document.getElementById('cal-month-prev');
            const next = document.getElementById('cal-month-next');
            if (!(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;
            if (!min || !max) {
                prev.disabled = true;
                next.disabled = true;
                return;
            }
            prev.disabled = displayedMonthKey <= min;
            next.disabled = displayedMonthKey >= max;
        }

        /** @param {string} mesKey */
        function renderCalendar(mesKey) {
            displayedMonthKey = mesKey;
            const cal = generarCalendario(mesKey + '-01');
            const diasConEventos = getDiasConEventosForMonth(mesKey);
            const mesActualElement = document.getElementById('mes-actual');
            const grid = document.getElementById('calendario-dias-grid');

            if (mesActualElement) mesActualElement.textContent = cal.nombreMes;
            if (!grid) return;

            const weeks = [];
            for (let i = 0; i < cal.dias.length; i += 7) {
                weeks.push(cal.dias.slice(i, i + 7));
            }

            grid.innerHTML = weeks
                .map(
                    (week) =>
                        `<div role="row" class="grid grid-cols-7 gap-0.5">` +
                        week
                            .map((dayInfo) => {
                                const hasEvent =
                                    dayInfo.isCurrentMonth &&
                                    diasConEventos.some(
                                        (d) => Number(d) === dayInfo.day,
                                    );
                                const cls = calendarDayClasses({
                                    isCurrentMonth: dayInfo.isCurrentMonth,
                                    isToday: dayInfo.isToday,
                                    fullDate: dayInfo.fullDate,
                                    day: dayInfo.day,
                                    diasConEventos,
                                    selectedIso: selectedDateIso,
                                });
                                const label = calendarDayAriaLabel(
                                    dayInfo.fullDate,
                                    hasEvent,
                                    (d) => dayjs(d),
                                );
                                const disabled = !dayInfo.isCurrentMonth
                                    ? ' disabled'
                                    : '';
                                const pressed =
                                    selectedDateIso === dayInfo.fullDate
                                        ? 'true'
                                        : 'false';
                                const ariaCurrent = dayInfo.isToday
                                    ? ' aria-current="date"'
                                    : '';
                                return `<button type="button" role="gridcell" class="${cls}" data-cal-date="${dayInfo.fullDate}"${disabled} aria-label="${escapeAttr(label)}" aria-pressed="${pressed}"${ariaCurrent}>${dayInfo.day}</button>`;
                            })
                            .join('') +
                        `</div>`,
                )
                .join('');

            updateNavButtons();
        }

        function getCalendarMarkerTop() {
            const monthTitle = document.getElementById('mes-actual');
            if (monthTitle) return monthTitle.getBoundingClientRect().top + 12;
            const calHost = document.getElementById('calendario-dinamico');
            if (calHost) return calHost.getBoundingClientRect().top + 36;
            return 192;
        }

        function smoothScrollToY(top) {
            const targetTop = Math.max(0, top);
            const L = window.__lenis__;
            if (L && typeof L.scrollTo === 'function') {
                L.scrollTo(targetTop, { duration: 0.55 });
                return;
            }
            window.scrollTo({ top: targetTop, behavior: 'smooth' });
        }

        function openMonthAccordion(mesKey, alignToCalendarTitle = false) {
            const details = document.querySelector(
                `details[data-month="${mesKey}"]`,
            );
            if (!(details instanceof HTMLDetailsElement)) return;
            details.open = true;
            const summary = details.querySelector('summary');
            if (!alignToCalendarTitle || !(summary instanceof HTMLElement)) {
                details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                return;
            }

            // Evita que el sync por scroll reescriba el mes durante el desplazamiento programático.
            suppressScrollSyncUntil = Date.now() + 650;

            // Alinea el título del mes del listado con el título del mes del calendario.
            const alignSummaryToMarker = () => {
                const markerTop = getCalendarMarkerTop();
                const summaryTop = summary.getBoundingClientRect().top;
                const delta = summaryTop - markerTop;
                if (Math.abs(delta) < 1) return;
                smoothScrollToY(window.scrollY + delta);
            };

            requestAnimationFrame(() => {
                alignSummaryToMarker();
                // Segunda corrección por si al abrir `details` cambia el layout unos ms después.
                setTimeout(alignSummaryToMarker, 120);
            });
        }

        /** @param {number} delta */
        function shiftMonth(delta) {
            const el = document.getElementById('calendario-dinamico');
            const min = el?.dataset.minMonth;
            const max = el?.dataset.maxMonth;
            if (!min || !max) return;
            const nk = dayjs(displayedMonthKey + '-01')
                .add(delta, 'month')
                .format('YYYY-MM');
            if (nk < min || nk > max) return;
            renderCalendar(nk);
            openMonthAccordion(nk, true);
        }

        const calHost = document.getElementById('calendario-dinamico');
        calHost?.addEventListener('click', (e) => {
            const t = e.target;
            if (!(t instanceof Element)) return;
            const btn = t.closest('button[data-cal-date]');
            if (!btn || !(btn instanceof HTMLButtonElement) || btn.disabled)
                return;
            const iso = btn.getAttribute('data-cal-date');
            if (!iso) return;
            const parts = iso.split('-');
            const mesKey = `${parts[0]}-${parts[1]}`;
            selectedDateIso =
                selectedDateIso === iso ? null : iso;
            renderCalendar(mesKey);
            if (selectedDateIso) openMonthAccordion(mesKey);
        });

        document
            .getElementById('cal-month-prev')
            ?.addEventListener('click', () => shiftMonth(-1));
        document
            .getElementById('cal-month-next')
            ?.addEventListener('click', () => shiftMonth(1));

        /**
         * Mes activo según scroll: usa el `<summary>` de cada mes (título), no el `details`
         * completo — si un mes está abierto y es muy alto, el bloque entero seguiría
         * “ganando” y el calendario no pasaría al mes siguiente.
         * El mes elegido es el de mayor `top` entre los que ya cruzaron la línea guía.
         */
        function syncCalendarToVisibleMonth() {
            if (Date.now() < suppressScrollSyncUntil) return;
            const sections = document.querySelectorAll(
                "details.event-month-details[data-month]",
            );
            if (sections.length === 0) return;

            const marker = Math.min(
                Math.max(window.innerHeight * 0.3, 120),
                260,
            );
            let bestKey = null;
            let bestTop = -Infinity;

            sections.forEach((details) => {
                const key = details.getAttribute("data-month");
                if (!key) return;
                const summary = details.querySelector("summary");
                if (!summary) return;
                const r = summary.getBoundingClientRect();
                if (r.bottom <= 2) return;
                if (r.top >= window.innerHeight - 2) return;
                if (r.top <= marker && r.top > bestTop) {
                    bestTop = r.top;
                    bestKey = key;
                }
            });

            if (bestKey && bestKey !== displayedMonthKey) {
                renderCalendar(bestKey);
            }
        }

        function scheduleScrollSync() {
            if (scrollSyncRaf) return;
            scrollSyncRaf = requestAnimationFrame(() => {
                scrollSyncRaf = 0;
                syncCalendarToVisibleMonth();
            });
        }

        function configurarScrollSyncCalendario() {
            scheduleScrollSync();
            window.addEventListener("scroll", scheduleScrollSync, {
                passive: true,
            });
            window.addEventListener("resize", scheduleScrollSync);

            let tries = 0;
            function attachLenis() {
                const L = window.__lenis__;
                if (L && typeof L.on === "function") {
                    L.on("scroll", scheduleScrollSync);
                    return;
                }
                if (tries++ < 180) requestAnimationFrame(attachLenis);
            }
            attachLenis();
        }

        const calEl0 = document.getElementById("calendario-dinamico");
        const mesInicial =
          (calEl0?.dataset.initialMonth || "").trim() ||
          document.querySelector("[data-month]")?.getAttribute("data-month") ||
          dayjs().format("YYYY-MM");
        displayedMonthKey = mesInicial;
        selectedDateIso = null;
        renderCalendar(mesInicial);
        configurarScrollSyncCalendario();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEventosPage);
    } else {
        initEventosPage();
    }
</script>

