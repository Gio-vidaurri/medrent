        <div class="max-w-[1320px] mx-auto overflow-visible px-0 lg:px-6">
            <div class="flex flex-col gap-[24px] overflow-visible lg:flex-row lg:items-stretch">
                
                <!-- Columna izquierda - Calendario compacto (altura = columna derecha para que sticky tenga recorrido) -->
                <div class="w-full shrink-0 px-4 py-0 md:px-6 lg:w-[34%] lg:max-w-[380px] lg:px-0 lg:py-[24px]">
                    <div
                        class="sticky top-[120px] z-10 w-full text-center font-sans"
                        data-lenis-prevent
                    >
                        <p
                            class="mb-1 text-left font-lato text-[14px] font-medium uppercase leading-5 tracking-[0.1px] text-[var(--color-primary)]"
                        >
                            {totalEventosCount} EVENTOS
                        </p>
                        <h2 class="mb-3 text-left font-lato text-xl font-medium leading-8 text-[#261819] md:text-2xl md:leading-9">
                            MedRent {agendaYearLabel}
                        </h2>

                        <div
                            class="hidden rounded-xl bg-[var(--color-secondary-light)] p-[24px] lg:block"
                            id="calendario-dinamico"
                            data-initial-month={displayMonth.format("YYYY-MM")}
                            data-min-month={calMinMonth}
                            data-max-month={calMaxMonth}
                            role="region"
                            aria-label="Calendario de eventos"
                        >
                            <div class="flex items-center justify-between gap-2">
                                <span
                                    id="mes-actual"
                                    class="font-lato text-base font-medium capitalize text-[#261819]"
                                    aria-live="polite"
                                >
                                    {currentMonthTitleCase}
                                </span>

                                <div class="flex shrink-0 gap-1">
                                    <button
                                        type="button"
                                        id="cal-month-prev"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-[#6D7A78] transition hover:bg-white/60 hover:text-[#261819] disabled:cursor-not-allowed disabled:opacity-35"
                                        aria-label="Mes anterior"
                                    >
                                        <span aria-hidden="true">&lt;</span>
                                    </button>
                                    <button
                                        type="button"
                                        id="cal-month-next"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-[#6D7A78] transition hover:bg-white/60 hover:text-[#261819] disabled:cursor-not-allowed disabled:opacity-35"
                                        aria-label="Mes siguiente"
                                    >
                                        <span aria-hidden="true">&gt;</span>
                                    </button>
                                </div>
                            </div>
                            <div id="calendario-dias" class="mt-3 block">
                                <div class="mb-2 grid grid-cols-7" aria-hidden="true">
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">DOM</div>
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">LUN</div>
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">MAR</div>
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">MIÉ</div>
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">JUE</div>
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">VIE</div>
                                    <div class="py-1 text-center text-[10px] font-medium text-gray-500 sm:text-xs">SÁB</div>
                                </div>
                                <div
                                    id="calendario-dias-grid"
                                    role="grid"
                                    aria-labelledby="mes-actual"
                                    class="flex flex-col gap-0.5"
                                >
                                    {calendarWeeks.map((week) => (
                                        <div role="row" class="grid grid-cols-7 gap-0.5">
                                            {week.map((dayInfo) => {
                                                const hasEvent =
                                                    dayInfo.isCurrentMonth &&
                                                    eventDays.includes(dayInfo.day);
                                                const cls = calendarDayClasses({
                                                    isCurrentMonth: dayInfo.isCurrentMonth,
                                                    isToday: dayInfo.isToday,
                                                    fullDate: dayInfo.fullDate,
                                                    day: dayInfo.day,
                                                    diasConEventos: eventDays,
                                                    selectedIso: null,
                                                });
                                                const label = calendarDayAriaLabel(
                                                    dayInfo.fullDate,
                                                    hasEvent,
                                                    (d) => dayjs(d),
                                                );
                                                return (
                                                    <button
                                                        type="button"
                                                        role="gridcell"
                                                        class={cls}
                                                        data-cal-date={dayInfo.fullDate}
                                                        disabled={!dayInfo.isCurrentMonth}
                                                        aria-label={label}
                                                        aria-pressed="false"
                                                        aria-current={dayInfo.isToday ? "date" : undefined}
                                                    >
                                                        {dayInfo.day}
                                                    </button>
                                                );
                                            })}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Columna derecha - Acordeón por mes (estado vacío Figma: padding 24px, gap icono–texto 16px) -->
                <div class="min-w-0 flex-1 px-4 py-0 md:px-6 lg:px-0 lg:py-[24px]">
                    <div class="flex flex-col">
                            {mesesOrdenados.map((mesKey, mesIndex) => {
                                const bucket = eventosPorMes[mesKey];
                                const mesData = bucket ?? {
                                    nombre: mesNombreFromKey(mesKey),
                                    eventos: [],
                                    diasConEventos: new Set(),
                                };
                                /** Todos los eventos del mes (Strapi); se listan aunque ya hayan pasado. */
                                const eventosDelMes = [...mesData.eventos].sort(
                                    sortEventosPorFechaInicio,
                                );
                                const diasArr = buildDiasConEventosEnMes(
                                    eventosDelMes,
                                    mesKey,
                                );
                                const tieneEventos = eventosDelMes.length > 0;
                                const tieneProximos = eventosDelMes.some(
                                    (e: any) => !isEventoPasado(e),
                                );

                                return (
                                    <details
                                        class="event-month-details"
                                        data-month={mesKey}
                                        data-event-days={JSON.stringify(diasArr)}
                                        open={tieneProximos}
                                    >
                                        <summary
                                            class="event-month-summary flex w-full cursor-pointer list-none items-center justify-between gap-4 border-b border-[#E8EEED] py-[24px] font-lato text-[#261819] [&::-webkit-details-marker]:hidden"
                                            aria-label={`Eventos de ${mesNombreFromKey(mesKey)}`}
                                        >
                                            <span class="text-left text-xl font-medium leading-8 text-[#261819] md:text-2xl md:leading-9">
                                                {mesTituloAcordion(mesKey, agendaMultiyear)}
                                            </span>
                                            <svg
                                                class="event-month-chevron h-6 w-6 shrink-0 text-[#261819] transition-transform duration-200"
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                strokeWidth="2"
                                                aria-hidden="true"
                                            >
                                                <path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </summary>
                                        <div class="pb-[24px] pt-6 md:pt-8">
                                            {tieneEventos ? (
                                                <div class="flex flex-col gap-6">
                                                    {eventosDelMes.map((evento) => {
                                                        const fechaInicio = dayjs(evento.startDate);
                                                        const fechaFin = dayjs(
                                                            evento.endDate ||
                                                                evento.startDate,
                                                        );
                                                        const mapsUrl =
                                                            (evento as { locationUrlMaps?: string }).locationUrlMaps ??
                                                            (evento as { locationUriMaps?: string }).locationUriMaps ??
                                                            "#";
                                                        const popupDateLabel = formatPopupDateLabel(evento.startDate);
                                                        const popupTimeLabel = formatPopupTimeLabel(
                                                            (evento as { startTime?: string }).startTime,
                                                            (evento as { endTime?: string }).endTime,
                                                        );

                                                        let fechaTexto = "";
                                                        if (fechaInicio.isSame(fechaFin, "day")) {
                                                            fechaTexto = fechaInicio.format("D [de] MMMM");
                                                        } else if (fechaInicio.isSame(fechaFin, "month")) {
                                                            fechaTexto = `Del ${fechaInicio.format("D")} al ${fechaFin.format("D [de] MMMM")}`;
                                                        } else {
                                                            fechaTexto = `Del ${fechaInicio.format("D [de] MMMM")} al ${fechaFin.format("D [de] MMMM")}`;
                                                        }

                                                        return (
                                                            <EventCard
                                                                evento={evento}
                                                                fechaTexto={fechaTexto}
                                                                mapsUrl={mapsUrl}
                                                                popupDateLabel={popupDateLabel}
                                                                popupTimeLabel={popupTimeLabel}
                                                            />
                                                        );
                                                    })}
                                                </div>
                                            ) : (
                                                <div
                                                    class="flex h-[384px] w-full shrink-0 flex-col items-center justify-center gap-4 self-stretch rounded-[24px] bg-[#F5FAF9] p-6 text-center backdrop-blur-[6px]"
                                                    role="status"
                                                    aria-live="polite"
                                                >
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="59"
                                                        height="59"
                                                        viewBox="0 0 59 59"
                                                        fill="none"
                                                        class="aspect-square h-[59px] w-[59px] shrink-0"
                                                        aria-hidden="true"
                                                    >
                                                        <path
                                                            d="M28.6643 17.2085H36.8751V19.6669C36.8751 20.3189 37.1341 20.9441 37.5952 21.4052C38.0562 21.8662 38.6815 22.1252 39.3335 22.1252C39.9855 22.1252 40.6108 21.8662 41.0718 21.4052C41.5328 20.9441 41.7918 20.3189 41.7918 19.6669V17.2085H44.2502C44.9022 17.2085 45.5275 17.4675 45.9885 17.9285C46.4495 18.3896 46.7085 19.0149 46.7085 19.6669V27.0419H43.4143C42.7623 27.0419 42.137 27.3009 41.676 27.7619C41.215 28.2229 40.956 28.8482 40.956 29.5002C40.956 30.1522 41.215 30.7775 41.676 31.2385C42.137 31.6996 42.7623 31.9586 43.4143 31.9586H46.7085V35.2528C46.7085 35.9047 46.9675 36.53 47.4285 36.9911C47.8896 37.4521 48.5149 37.7111 49.1669 37.7111C49.8189 37.7111 50.4441 37.4521 50.9052 36.9911C51.3662 36.53 51.6252 35.9047 51.6252 35.2528V19.6669C51.6252 17.7109 50.8482 15.835 49.4651 14.4519C48.082 13.0688 46.2061 12.2918 44.2502 12.2918H41.7918V9.83348C41.7918 9.18149 41.5328 8.5562 41.0718 8.09517C40.6108 7.63414 39.9855 7.37514 39.3335 7.37514C38.6815 7.37514 38.0562 7.63414 37.5952 8.09517C37.1341 8.5562 36.8751 9.18149 36.8751 9.83348V12.2918H28.6643C28.0123 12.2918 27.387 12.5508 26.926 13.0119C26.4649 13.4729 26.2059 14.0982 26.2059 14.7502C26.2059 15.4022 26.4649 16.0275 26.926 16.4885C27.387 16.9495 28.0123 17.2085 28.6643 17.2085ZM53.3706 49.8799L49.4373 45.9466L9.12044 5.62972C8.89123 5.4005 8.61912 5.21868 8.31963 5.09463C8.02015 4.97059 7.69917 4.90674 7.37502 4.90674C7.05086 4.90674 6.72988 4.97059 6.4304 5.09463C6.13092 5.21868 5.85881 5.4005 5.62959 5.62972C5.16668 6.09263 4.90662 6.72048 4.90662 7.37514C4.90662 8.0298 5.16668 8.65765 5.62959 9.12056L10.325 13.7914C9.4124 14.4759 8.67099 15.3627 8.1591 16.3822C7.64722 17.4017 7.37883 18.5261 7.37502 19.6669V44.2503C7.37502 46.2063 8.15203 48.0821 9.53511 49.4652C10.9182 50.8483 12.7941 51.6253 14.75 51.6253H44.2502C45.349 51.6188 46.4325 51.3668 47.4214 50.8878L49.8798 53.3462C50.1083 53.5766 50.3802 53.7595 50.6798 53.8843C50.9794 54.0091 51.300