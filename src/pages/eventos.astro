// Configurar dayjs en español
dayjs.locale('es');

/** Fecha larga para el modal (ej. "4 de febrero, 2026") */
function formatPopupDateLabel(iso: string | undefined) {
  if (!iso) return "";
  return dayjs(iso).format("D [de] MMMM, YYYY");
}

/** Horario desde campos de Strapi (time o datetime) */
function formatPopupTimeLabel(startTime: unknown, endTime: unknown) {
  const parseOne = (t: unknown): string | null => {
    if (t == null || t === "") return null;
    const s = String(t).trim();
    const hm = s.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?(?:\.\d+)?$/);
    if (hm) {
      const h = parseInt(hm[1], 10);
      const m = parseInt(hm[2], 10);
      const sec = parseInt(hm[3] ?? "0", 10);
      return dayjs().hour(h).minute(m).second(sec).format("hh:mm A");
    }
    const d = dayjs(s);
    return d.isValid() ? d.format("hh:mm A") : s;
  };
  const a = parseOne(startTime);
  const b = parseOne(endTime);
  if (a && b && a !== b) return `${a} – ${b}`;
  return a || b || "";
}

function mesNombreFromKey(mesKey: string) {
  const raw = dayjs(mesKey + "-01").format("MMMM YYYY");
  return raw.charAt(0).toUpperCase() + raw.slice(1).toLowerCase();
}

/**
 * Título del acordeón por mes.
 * Si la agenda abarca varios años, incluye año ("Marzo 2026") para evitar colisiones.
 */
function mesTituloAcordion(mesKey: string, incluirAno: boolean) {
  const raw = dayjs(mesKey + "-01").format(incluirAno ? "MMMM YYYY" : "MMMM");
  return raw.charAt(0).toUpperCase() + raw.slice(1).toLowerCase();
}

function monthKeysInRangeInclusive(minKey: string, maxKey: string): string[] {
  const keys: string[] = [];
  let d = dayjs(minKey + "-01");
  const end = dayjs(maxKey + "-01");
  if (!d.isValid() || !end.isValid()) return keys;
  while (d.isBefore(end, "month") || d.isSame(end, "month")) {
    keys.push(d.format("YYYY-MM"));
    d = d.add(1, "month");
  }
  return keys;
}

/** Fin del evento antes de hoy (local) → no se lista ni en calendario activo. */
function isEventoPasado(evento: { startDate?: string; endDate?: string }) {
  if (!evento?.startDate) return true;
  const fin = dayjs(evento.endDate || evento.startDate).startOf("day");
  return fin.isBefore(dayjs().startOf("day"));
}

/** Días del mes con al menos uno de los `eventos` (solo próximos al usar esa lista). */
function buildDiasConEventosEnMes(eventos: any[], mesKey: string): number[] {
  const set = new Set<number>();
  for (const evento of eventos) {
    if (!evento?.startDate) continue;
    const fechaInicio = dayjs(evento.startDate);
    const fechaFin = dayjs(evento.endDate || evento.startDate);
    let diaActual = fechaInicio;
    while (
      diaActual.isBefore(fechaFin, "day") ||
      diaActual.isSame(fechaFin, "day")
    ) {
      if (diaActual.format("YYYY-MM") === mesKey) {
        set.add(diaActual.date());
      }
      diaActual = diaActual.add(1, "day");
    }
  }
  return [...set].sort((a, b) => a - b);
}

/** Imagen Strapi (relación plana o data.attributes). */
function normalizeStrapiMedia(img: any): any {
  if (img == null || typeof img !== "object") return img;
  if ("url" in img && img.url) return img;
  const d = img.data;
  if (d && typeof d === "object" && "attributes" in d && d.attributes)
    return d.attributes;
  if (Array.isArray(d) && d[0]?.attributes) return d[0].attributes;
  return img;
}

/** Ítem de evento Strapi v4/v5 o ya plano desde la página singleton. */
function normalizeEventEntry(entry: any): any {
  if (entry == null || typeof entry !== "object") return entry;
  const base =
    "attributes" in entry &&
    entry.attributes &&
    typeof entry.attributes === "object"
      ? {
          id: entry.id,
          documentId: (entry as { documentId?: string }).documentId,
          ...entry.attributes,
        }
      : { ...entry };
  if (base.image) base.image = normalizeStrapiMedia(base.image);
  if (base.start_date && !base.startDate) base.startDate = base.start_date;
  if (base.end_date && !base.endDate) base.endDate = base.end_date;
  if (base.eventDate && !base.startDate) base.startDate = base.eventDate;
  if (base.date && !base.startDate) base.startDate = base.date;
  if (typeof base.startDate === "string") base.startDate = base.startDate.trim();
  if (typeof base.endDate === "string") base.endDate = base.endDate.trim();
  return base;
}

const rawHeroTitle =
  typeof data.title === "string" ? data.title.trim() : "";
const rawHeroDesc =
  typeof data.description === "string" ? data.description.trim() : "";
/** Valores legacy de Strapi / catch → copy de diseño. */
const heroTitle =
  !rawHeroTitle || rawHeroTitle === "Eventos médicos"
    ? DEFAULT_HERO_TITLE
    : data.title;
const heroDescription =
  !rawHeroDesc || rawHeroDesc.startsWith("Mantente actualizado")
    ? DEFAULT_HERO_DESCRIPTION
    : data.description;
if (data.heroImage) {
  data.heroImage = normalizeStrapiMedia(data.heroImage);
}

/** Relación Strapi: array plano o { data: entity[] }. */
function unwrapRelationEntries(rel: unknown): any[] {
  if (Array.isArray(rel)) return rel;
  if (
    rel &&
    typeof rel === "object" &&
    Array.isArray((rel as { data?: unknown }).data)
  ) {
    return (rel as { data: any[] }).data;
  }
  if (
    rel &&
    typeof rel === "object" &&
    (rel as { data?: unknown }).data &&
    typeof (rel as { data: unknown }).data === "object"
  ) {
    return [(rel as { data: unknown }).data];
  }
  return [];
}

function eventDedupeKey(e: any): string {
  if (e?.id != null && e.id !== "") return `id:${e.id}`;
  const doc = e?.documentId;
  if (doc) return `doc:${doc}`;
  const slug = e?.slug;
  if (slug) return `slug:${slug}`;
  const stamp =
    e?.createdAt ??
    e?.created_at ??
    e?.publishedAt ??
    e?.published_at ??
    e?.updatedAt ??
    "";
  return `f:${e?.startDate ?? ""}:${String(e?.title ?? "")}:${String(stamp)}`;
}

const now = dayjs();

/**
 * Todas las páginas de una colección Strapi.
 * Si `sort=startDate` no existe en el modelo, Strapi responde 400 y antes perdíamos la colección entera.
 */
async function strapiFetchCollectionAll(apiPath: string): Promise<any[]> {
  const pageSize = 100;
  const maxPages = 50;
  const all: any[] = [];
  let queryBase = `populate=image&sort=startDate:asc`;
  try {
    await strapiFetch(
      `${apiPath}?${queryBase}&pagination[pageSize]=1&pagination[page]=1`,
    );
  } catch {
    queryBase = "populate=image";
  }
  for (let page = 1; page <= maxPages; page += 1) {
    const res = await strapiFetch(
      `${apiPath}?${queryBase}&pagination[pageSize]=${pageSize}&pagination[page]=${page}`,
    );
    const batch = res?.data;
    if (!Array.isArray(batch) || batch.length === 0) break;
    all.push(...batch);
    if (batch.length < pageSize) break;
  }
  return all;
}

function sortEventosPorFechaInicio(a: any, b: any): number {
  return dayjs(a.startDate).valueOf() - dayjs(b.startDate).valueOf();
}

const eventosFromPage = unwrapRelationEntries(data?.events)
  .map(normalizeEventEntry)
  .filter((e: any) => e?.startDate);

/** Unión: relación en `events-page` + todas las colecciones API (antes solo se usaba el 1.er endpoint con datos). */
const eventosMerged = new Map<string, any>();
for (const apiPath of ["/events", "/eventos"] as const) {
  try {
    const rows = await strapiFetchCollectionAll(apiPath);
    for (const row of rows) {
      const e = normalizeEventEntry(row);
      if (!e?.startDate) continue;
      const k = eventDedupeKey(e);
      if (!eventosMerged.has(k)) eventosMerged.set(k, e);
    }
  } catch {
    /* endpoint distinto o no disponible */
  }
}
for (const e of eventosFromPage) {
  const k = eventDedupeKey(e);
  if (!eventosMerged.has(k)) eventosMerged.set(k, e);
}
let eventosListForLayout: any[] = [...eventosMerged.values()];

const eventosPorMes: Record<
  string,
  { nombre: string; eventos: any[]; diasConEventos: Set<number> }
> = {};

eventosListForLayout.forEach((evento: any) => {
  if (!evento?.startDate) return;
  const fechaInicio = dayjs(evento.startDate);
  const mesKey = fechaInicio.format("YYYY-MM");
  const mesNombreRaw = fechaInicio.format("MMMM YYYY");
  const mesNombre =
    mesNombreRaw.charAt(0).toUpperCase() + mesNombreRaw.slice(1).toLowerCase();

  if (!eventosPorMes[mesKey]) {
    eventosPorMes[mesKey] = {
      nombre: mesNombre,
      eventos: [],
      diasConEventos: new Set(),
    };
  }

  const fechaFinEvento = dayjs(evento.endDate || evento.startDate);
  let diaActual = fechaInicio;
  while (
    diaActual.isBefore(fechaFinEvento, "day") ||
    diaActual.isSame(fechaFinEvento, "day")
  ) {
    if (diaActual.format("YYYY-MM") === mesKey) {
      eventosPorMes[mesKey].diasConEventos.add(diaActual.date());
    }
    diaActual = diaActual.add(1, "day");
  }

  eventosPorMes[mesKey].eventos.push(evento);
});

const eventYears = eventosListForLayout
  .map((e: any) => (e?.startDate ? dayjs(e.startDate).year() : null))
  .filter((y: number | null): y is number => y != null);
const minEventYear =
  eventYears.length > 0 ? Math.min(...eventYears) : now.year();
const maxEventYear =
  eventYears.length > 0 ? Math.max(...eventYears) : now.year();
/**
 * Rango de años en la agenda: incluye el año actual y todos los años con eventos
 * (antes solo se mostraba un año y los eventos en otro año desaparecían del listado).
 */
const agendaStartYear = Math.min(now.year(), minEventYear);
const agendaEndYear = Math.max(now.year(), maxEventYear);
const agendaMultiyear = agendaStartYear !== agendaEndYear;

const mesesOrdenados = monthKeysInRangeInclusive(
  `${agendaStartYear}-01`,
  `${agendaEndYear}-12`,
);

const agendaYearLabel =
  agendaStartYear === agendaEndYear
    ? `${agendaEndYear}`
    : `${agendaStartYear} – ${agendaEndYear}`;

/** Label lateral: total de eventos en el rango de años de agenda (coincide con lo publicado en Strapi). */
const totalEventosCount = eventosListForLayout.filter((e: any) => {
  if (!e?.startDate) return false;
  const y = dayjs(e.startDate).year();
  return y >= agendaStartYear && y <= agendaEndYear;
}).length;

const firstMesKeyConProximos = mesesOrdenados.find((k) => {
  const ev = eventosPorMes[k]?.eventos ?? [];
  return ev.some((e: any) => !isEventoPasado(e));
});

/** Calendario SSR: mes del primer evento próximo, o mes actual si cae en el año de agenda. */
const displayMonth = firstMesKeyConProximos
  ? dayjs(firstMesKeyConProximos + "-01")
  : now.year() >= agendaStartYear && now.year() <= agendaEndYear
    ? now
    : dayjs(`${agendaEndYear}-01-01`);

const currentMonthTitleCase = (() => {
  const raw = displayMonth.format("MMMM YYYY");
  return raw.charAt(0).toUpperCase() + raw.slice(1).toLowerCase();
})();

const startOfMonthCal = displayMonth.startOf("month");
const startOfWeek = startOfMonthCal.startOf("week");

const calendarDays: {
  day: number;
  isCurrentMonth: boolean;
  isToday: boolean;
  fullDate: string;
}[] = [];
let currentDay = startOfWeek;
for (let i = 0; i < 42; i++) {
  const isCurrentMonth = currentDay.month() === displayMonth.month();
  const dayNumber = currentDay.date();
  const isToday = currentDay.isSame(now, "day");
  calendarDays.push({
    day: dayNumber,
    isCurrentMonth,
    isToday,
    fullDate: currentDay.format("YYYY-MM-DD"),
  });
  currentDay = currentDay.add(1, "day");
}

const firstMesKeyCal = displayMonth.format("YYYY-MM");
const eventosCalMesTodos = eventosPorMes[firstMesKeyCal]?.eventos ?? [];
const eventDays = buildDiasConEventosEnMes(eventosCalMesTodos, firstMesKeyCal);

const calMinMonth = `${agendaStartYear}-01`;
const calMaxMonth = `${agendaEndYear}-12`;

function chunkDays<T>(arr: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
  return out;
}

const calendarWeeks = chunkDays(calendarDays, 7);

const baseUrl = Astro.site ? new URL(Astro.site).origin : "https://www.medrent.mx";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const logoUrl = `${baseUrl}/favicon-512.png`;
const heroImageUrl = data?.heroImage?.url ?? logoUrl;
