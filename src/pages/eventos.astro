                                                            fill="#006764"
                                                        />
                                                    </svg>
                                                    <p
                                                        class="self-stretch text-center font-lato text-2xl font-bold leading-8 text-[var(--Schemes-On-Surface)]"
                                                    >
                                                        Este mes no cuenta con eventos programados
                                                    </p>
                                                    <p
                                                        class="self-stretch text-center font-lato text-sm font-normal leading-5 tracking-[0.25px] text-[var(--Schemes-On-Surface)]"
                                                    >
                                                        Consulta otros meses para conocer nuestras próximas actividades
                                                        académicas y clínicas.
                                                    </p>
                                                </div>
                                            )}
                                        </div>
                                    </details>
                                );
                            })}
                    </div>
                </div>
            
            </div>
        </div>
    </section>

    <!-- Slider de promociones (misma fuente que home/PLP/PDP: getPromotionSlides) -->
    <PromotionSlider promotionsData={promotionsData} />


    <!-- Blog: mismo bloque que index.astro (sin defer-section: página larga + Glide; evita cards invisibles) -->
    <section class="max-w-7xl mx-auto py-8 sliderArticulosRelacionados px-4 md:px-6">
        <span class="mb-2 uppercase font-kallisto text-[12px] font-medium leading-[20px] tracking-[0.1px] text-[var(--color-accent)]">BLOG</span>
        <h3 class="mb-6 font-lato medrent-headline-section">Explora artículos y noticias sobre tecnología médica, innovación y cuidado especializado para mejorar la salud y el bienestar.</h3>
        <SlideArticles articulos={articulosRelacionados} tagByArticleKey={classificationTagByArticleKey} />
    </section>


<script>
    import dayjs from 'dayjs';
    import 'dayjs/locale/es';
    import {
        calendarDayAriaLabel,
        calendarDayClasses,
    } from '@lib/eventos/calendarDayClasses';

    dayjs.locale('es');

    function escapeAttr(s) {
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;');
    }

    // Script unificado para eventos, popup y calendario.
    // Los scripts con import se ejecutan como módulo (defer); DOMContentLoaded puede haber pasado ya.
    function initEventosPage() {
        // Popup
        const popupOverlay = document.getElementById('event-popup-overlay');
        const popupTitle = document.getElementById('event-popup-title');
        const popupDescription = document.getElementById('event-popup-description');
        const popupEventType = document.getElementById('event-popup-event-type');
        const popupDate = document.getElementById('event-popup-date');
        const popupTime = document.getElementById('event-popup-time');
        const popupLocationLabel = document.getElementById('event-popup-location-label');
        const popupImage = document.getElementById('event-popup-image');
        
        // Formulario
        const form = document.getElementById("events-form");
        const status = document.getElementById("status");
        
        // Resetear popup a estado inicial
        function resetPopupToInitial() {
            if (popupTitle) popupTitle.textContent = 'Título del evento';
            if (popupDescription) {
                popupDescription.textContent = 'Descripción del evento';
                popupDescription.classList.remove('hidden');
            }
            if (popupEventType) {
                popupEventType.textContent = '';
                popupEventType.classList.add('hidden');
            }
            if (popupDate) popupDate.textContent = '';
            if (popupTime) popupTime.textContent = '';
            if (popupLocationLabel) popupLocationLabel.textContent = '';
            document.getElementById('event-popup-meta-date')?.classList.add('hidden');
            document.getElementById('event-popup-time-row')?.classList.add('hidden');
            document.getElementById('event-popup-meta-location')?.classList.add('hidden');
            const locLinkReset = document.getElementById('event-popup-location-link');
            if (locLinkReset) {
                locLinkReset.href = '#';
                locLinkReset.classList.add('pointer-events-none');
            }
            
            if (popupImage) {
                popupImage.style.display = 'block';
            }
            
            // Restaurar formulario
            if (form) {
                form.style.display = 'block';
                form.reset();
                document.querySelector('.form-container')?.classList.remove('hidden');
                document.querySelector('.form-success')?.classList.add('hidden');
                document.querySelector('.form-error')?.classList.add('hidden');
            }
            
            const leftColumn = document.getElementById('event-popup-left');
            const rightColumn = document.getElementById('event-popup-right');
            if (leftColumn) leftColumn.style.display = '';
            if (rightColumn) rightColumn.style.display = '';
            
            if (status) {
                status.innerHTML = '';
                status.style.display = 'none';
                status.classList.add('hidden');
            }
        }
        
        // Abrir popup
        function openEventPopup(eventData) {
            if (!popupOverlay) return;

            resetPopupToInitial();
            
            if (popupImage) {
                if (eventData.img) popupImage.src = eventData.img;
                popupImage.alt = eventData.title || 'Evento';
            }
            if (popupTitle && eventData.title) popupTitle.textContent = eventData.title;
            const desc = eventData.description || '';
            if (popupDescription) {
                popupDescription.textContent = desc;
                popupDescription.classList.toggle('hidden', !desc);
            }

            const et = eventData.eventType || '';
            if (popupEventType) {
                popupEventType.textContent = et;
                popupEventType.classList.toggle('hidden', !et);
            }

            const dateLabel = eventData.dateLabel || '';
            const metaDate = document.getElementById('event-popup-meta-date');
            if (popupDate) popupDate.textContent = dateLabel;
            metaDate?.classList.toggle('hidden', !dateLabel);

            const timeLabel = eventData.timeLabel || '';
            const timeRow = document.getElementById('event-popup-time-row');
            if (popupTime) popupTime.textContent = timeLabel;
            timeRow?.classList.toggle('hidden', !timeLabel);

            const locLabel = eventData.locationLabel || '';
            const metaLoc = document.getElementById('event-popup-meta-location');
            if (popupLocationLabel) popupLocationLabel.textContent = locLabel;
            metaLoc?.classList.toggle('hidden', !locLabel);

            const locLink = document.getElementById('event-popup-location-link');
            const url =
                eventData.locationUrl && eventData.locationUrl !== '#' ? eventData.locationUrl : '';
            if (locLink) {
                if (url) {
                    locLink.href = url;
                    locLink.classList.remove('pointer-events-none');
                    locLink.target = '_blank';
                    locLink.rel = 'noopener noreferrer';
                } else {
                    locLink.href = '#';
                    locLink.classList.add('pointer-events-none');
                }
            }
            /** No aplicar `filter` en <main>: rompe `position:fixed` del overlay (viewport / stacking). */
            popupOverlay.classList.remove('hidden');
            popupOverlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }
        
        // Cerrar popup
        function closeEventPopup() {
            if (!popupOverlay) return;
            
            popupOverlay.classList.add('hidden');
            popupOverlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = 'auto';
            resetPopupToInitial();

        }
        
        // Mostrar mensaje después de enviar formulario
        function showFormMessage(type) {
            // Ocultar elementos
            if (form) form.style.display = 'none';
            if (popupImage) popupImage.style.display = 'none';
            
            const leftColumn = document.getElementById('event-popup-left');
            const rightColumn = document.getElementById('event-popup-right');
            if (leftColumn) leftColumn.style.display = 'none';
            if (rightColumn) rightColumn.style.display = 'none';
            
            // Mostrar mensaje
            if (status) {
                status.classList.remove('hidden');
                status.style.display = 'flex';
                status.style.flexDirection = 'column';
                status.style.alignItems = 'center';
                status.style.justifyContent = 'center';
                status.style.minHeight = '500px';
                status.style.padding = '16px';
                status.style.width = '100%';
                
                if (type === 'success') {
                    status.innerHTML = `
                        <div class="w-full mx-auto p-6 md:p-8 flex flex-col items-center justify-center gap-4 rounded-3xl border border-[#006764] bg-[#F5FAF9] shadow-[0_20px_24px_-4px_rgba(49,48,48,0.10),0_8px_10px_-6px_rgba(49,48,48,0.04)] min-h-[500px] relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="104" height="104" viewBox="0 0 104 104" fill="none">
                                <mask id="mask0_521_7249" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="104" height="104">
                                    <path d="M104 0H0V104H104V0Z" fill="white"/>
                                </mask>
                                <g mask="url(#mask0_521_7249)">
                                    <path d="M91 52C91 73.541 73.541 91 52 91C30.459 91 13 73.541 13 52C13 30.459 30.459 13 52 13C73.541 13 91 30.459 91 52Z" stroke="#006764" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M39 55.25L48.75 65L65 42.25" stroke="#006764" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </g>
                            </svg>
                            <p class="text-[#006764] font-bold text-base md:text-lg lg:text-xl text-center font-lato">REGISTRO COMPLETADO</p>
                            <p class="text-[#171D1C] text-center font-lato text-lg md:text-xl lg:text-2xl font-bold leading-6 md:leading-8">¡Tu acceso al programa está listo!</p>
                            <p class="text-[#171D1C] font-400 text-sm md:text-base lg:text-xl text-center font-lato">Gracias por registrarte. En breve recibirás un correo con tu código QR.</p>
                            <p class="text-[var--color-gray-dark)] text-xs md:text-sm text-center font-lato">
                                Mientras tanto, explora más en 
                                <a href="/productos" class="text-[#006764] underline hover:no-underline">nuestro catálogo</a>
                            </p>
                        </div>
                    `;
                } else {
                    status.innerHTML = `
                        <div class="w-full mx-auto p-6 md:p-8 flex flex-col items-center justify-center gap-4 rounded-3xl border border-[#006764] bg-[#F5FAF9] shadow-[0_20px_24px_-4px_rgba(49,48,48,0.10),0_8px_10px_-6px_rgba(49,48,48,0.04)] min-h-[500px] relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="59" height="59" viewBox="0 0 59 59" fill="none">
