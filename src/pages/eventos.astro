                          loading="eager"
                          decoding="async"
                          fetchpriority="high"
                        />
                    </div>
                </div>  
            </div>
        </div>
    </section>
    
    <!-- Sección Calendario y Eventos (gutter 24px = gap-6; padding lateral 24px en lg) -->
